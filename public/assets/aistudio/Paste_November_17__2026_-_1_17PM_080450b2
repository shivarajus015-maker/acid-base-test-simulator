      if (simState.animating || simState.hibiscusStage !== 'A1') return;
      setAnimatingState(true, '🥣 Crushing hibiscus petals...');
      audio.init();
      audio.playCrush();

      const origPestleY = 0.35;
      const startTime = performance.now();
      const duration = 380;

      function anim(t) {
        const p = Math.min((t - startTime) / duration, 1.0);
        pestleGroup.position.y = origPestleY - Math.sin(p * Math.PI) * 0.22;
        pestleGroup.scale.y = 1.0 - Math.sin(p * Math.PI) * 0.14;

        if (p < 1.0) {
          requestAnimationFrame(anim);
        } else {
          pestleGroup.position.y = origPestleY;
          pestleGroup.scale.set(1, 1, 1);
          simState.crushCount++;

          mortarPetalMeshes.forEach(mesh => {
            mesh.material.color.lerp(new THREE.Color('#380310'), 0.35);
          });

          if (simState.crushCount >= 3) {
            simState.hibiscusStage = 'A2';
            audio.playSuccess();
            spawnCelebration(['#f43f5e', '#fbbf24']);
            showToast('🥣 Great crushing! Now tap the warm water beaker!', 'success');
          }
          setAnimatingState(false);
          updateGuidanceCard();
          if (onDone) onDone();
        }
      }
      requestAnimationFrame(anim);
    }

    function addWarmWater() {
      if (simState.animating || simState.hibiscusStage !== 'A2') return;
      setAnimatingState(true, '♨️ Pouring warm water...');
      audio.init();
      audio.playPour();

      const origPos = beakerGroup.position.clone();
      const targetPos = new THREE.Vector3(-4.5, 1.6, 0.4);
      const startTime = performance.now();
      const duration = 2000;

      function anim(t) {
        const p = Math.min((t - startTime) / duration, 1.0);

        if (p < 0.25) {
          beakerGroup.position.lerpVectors(origPos, targetPos, p / 0.25);
        } else if (p < 0.75) {
          const pPour = (p - 0.25) / 0.5;
          beakerGroup.rotation.z = Math.sin(pPour * Math.PI) * 0.85;
          mortarLiquidMat.uniforms.uOpacity.value = pPour * 0.88;
          beakerWater.scale.y = 1.0 - pPour * 0.45;
        } else {
          const pRet = (p - 0.75) / 0.25;
          beakerGroup.rotation.z = 0;
          beakerGroup.position.lerpVectors(targetPos, origPos, pRet);
        }

        if (p < 1.0) {
          requestAnimationFrame(anim);
        } else {
          beakerGroup.position.copy(origPos);
          beakerGroup.rotation.set(0, 0, 0);
          simState.waterAdded = true;
          simState.hibiscusStage = 'A3';
          audio.playSuccess();
          showToast('♨️ Rich crimson extract formed! Tap the filter funnel next!', 'success');
          setAnimatingState(false);
          updateGuidanceCard();
        }
      }
      requestAnimationFrame(anim);
    }

    function filterAndBottle() {
      if (simState.animating || simState.hibiscusStage !== 'A3') return;
      setAnimatingState(true, '🧪 Filtering hibiscus indicator...');
      audio.init();
      audio.playPour();

      const origPos = mortarGroup.position.clone();
      const targetPos = new THREE.Vector3(-2.0, 2.8, -0.6);
      const startTime = performance.now();
      const duration = 2200;

      function anim(t) {
        const p = Math.min((t - startTime) / duration, 1.0);

        if (p < 0.25) {
          mortarGroup.position.lerpVectors(origPos, targetPos, p / 0.25);
        } else if (p < 0.75) {
          const pFilter = (p - 0.25) / 0.5;
          mortarGroup.rotation.z = Math.sin(pFilter * Math.PI) * 0.7;
          bottleLiquidMat.uniforms.uOpacity.value = pFilter * 0.92;
          mortarLiquidMat.uniforms.uOpacity.value = 0.88 * (1.0 - pFilter);
        } else {
          const pRet = (p - 0.75) / 0.25;
          mortarGroup.rotation.z = 0;
          mortarGroup.position.lerpVectors(targetPos, origPos, pRet);
        }

        if (p < 1.0) {
          requestAnimationFrame(anim);
        } else {
          mortarGroup.position.copy(origPos);
          mortarGroup.rotation.set(0, 0, 0);
          simState.isFiltered = true;
          simState.hibiscusStage = 'A4';
          audio.playSuccess();
          spawnCelebration(['#f43f5e', '#10b981', '#fbbf24', '#38bdf8']);
          showToast('🎉 Hibiscus Indicator is ready! Tap any test tube to test!', 'success', 3200);
          setAnimatingState(false);
          updateGuidanceCard();
        }
      }
      requestAnimationFrame(anim);
    }

    function testTubeHibiscus(index, onDone) {
      if (simState.animating) return;
      if (simState.hibiscusStage !== 'A4') {
        showToast('💡 Finish preparing the Hibiscus extract first (click the glowing gold ring)!', 'neutral');
        return;
      }
      const targetTube = testTubesA[index];
      if (!targetTube) return;

      const s = targetTube.substance;
      setAnimatingState(true, `🌺 Testing ${s.nameEn}...`);
      audio.init();

      // Compute exact target position in filterUnitGroup local space
      const tubeWorld = new THREE.Vector3();
      targetTube.container.getWorldPosition(tubeWorld);
      const targetLocal = filterUnitGroup.worldToLocal(tubeWorld.clone().add(new THREE.Vector3(0, 2.25, 0)));
      const dropperOrigPos = hibiscusBottleGroup.position.clone();

      dropMesh.material.color.set('#be123c');
      let lastPlink = 0;

      const startTime = performance.now();
      const duration = 2200;

      function anim(t) {
        const elapsed = t - startTime;
        const p = Math.min(elapsed / duration, 1.0);

        if (p < 0.22) {
          hibiscusBottleGroup.position.lerpVectors(dropperOrigPos, targetLocal, p / 0.22);
          dropMesh.visible = false;
        } else if (p < 0.78) {
          const pDrops = (p - 0.22) / 0.56;
          targetTube.liquidMat.uniforms.uColorMix.value = pDrops;
          targetTube.liquidMat.uniforms.uRipple.value = 1.0;

          // 3 falling droplet cycles
          const dropPhase = (pDrops * 3) % 1;
          dropMesh.visible = true;
          dropMesh.position.set(tubeWorld.x, tubeWorld.y + 2.15 - dropPhase * 1.15, tubeWorld.z);

          const stage = Math.floor(pDrops * 3) + 1;
          if (stage !== lastPlink && stage <= 3) {
            lastPlink = stage;
            audio.playPlink(stage);
          }
        } else {
          dropMesh.visible = false;
          const pRet = (p - 0.78) / 0.22;
          targetTube.liquidMat.uniforms.uRipple.value = 0.0;
          hibiscusBottleGroup.position.lerpVectors(targetLocal, dropperOrigPos, pRet);
        }

        if (p < 1.0) {
          requestAnimationFrame(anim);
        } else {
          hibiscusBottleGroup.position.copy(dropperOrigPos);
          dropMesh.visible = false;
          testState[s.id].hibiscusTested = true;
          testState[s.id].hibiscusMix = 1.0;

          const badgeClass = s.category === 'acid' ? 'tested-acid' : (s.category === 'base' ? 'tested-base' : 'tested-neutral');
          targetTube.labelDiv.className = `label-3d tube-pill ${badgeClass}`;
          targetTube.labelDiv.innerHTML = renderTubeLabelHTML(index, s, `🌺 ${s.hibiscusResultEn}`, s.hibiscusColorHex);

          audio.playSuccess();
          if (s.category === 'acid') {
            showToast(`🌺 ${s.nameEn} turned ${s.hibiscusResultEn}! → Acid (${s.typeKn})`, 'acid', 2800);
          } else if (s.category === 'base') {
            showToast(`🌺 ${s.nameEn} turned ${s.hibiscusResultEn}! → Base (${s.typeKn})`, 'base', 2800);
          } else {
            showToast(`🌺 ${s.nameEn}: No change! → Neutral (${s.typeKn})`, 'neutral', 2800);
          }

          const allDone = activeSubstances.every(item => testState[item.id].hibiscusTested);
          if (allDone) spawnCelebration();

          setAnimatingState(false);
          updateGuidanceCard();
          populateMatrixTable();
          if (onDone) onDone();
        }
      }
      requestAnimationFrame(anim);
    }

    function prepareLitmus() {
      if (simState.animating || simState.litmusPrepared) return;
      setAnimatingState(true, '🧫 Extracting purple Litmus dye...');
      audio.init();
      audio.playGrind();

      const startTime = performance.now();
      const duration = 1600;

      function anim(t) {
        const p = Math.min((t - startTime) / duration, 1.0);
        lichenPestle.rotation.z = Math.sin(p * Math.PI * 6) * 0.3;
        litmusBottleLiquidMat.uniforms.uOpacity.value = p * 0.92;

