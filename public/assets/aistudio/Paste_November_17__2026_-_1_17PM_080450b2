    function pluckPetal(petalMesh) {
      if (simState.animating || petalMesh.userData.plucked) return;
      setAnimatingState(true, '🌸 Plucking petal...');
      audio.init();
      audio.playPluck();

      petalMesh.userData.plucked = true;

      // Convert petal to world space in scene so arc lands accurately in mortar (-4.5, 0.28, 0.4)
      const worldStart = new THREE.Vector3();
      petalMesh.getWorldPosition(worldStart);
      scene.attach(petalMesh);

      const targetPos = new THREE.Vector3(
        -4.5 + (Math.random() - 0.5) * 0.35,
        0.32,
        0.4 + (Math.random() - 0.5) * 0.35
      );

      const startTime = performance.now();
      const duration = 560;

      function anim(t) {
        const p = Math.min((t - startTime) / duration, 1.0);
        const ease = 1 - Math.pow(1 - p, 3);

        petalMesh.position.x = THREE.MathUtils.lerp(worldStart.x, targetPos.x, ease);
        petalMesh.position.z = THREE.MathUtils.lerp(worldStart.z, targetPos.z, ease);
        petalMesh.position.y = THREE.MathUtils.lerp(worldStart.y, targetPos.y, ease) + Math.sin(p * Math.PI) * 1.15;
        petalMesh.rotation.x += 0.08;
        petalMesh.rotation.y += 0.08;

        if (p < 1.0) {
          requestAnimationFrame(anim);
        } else {
          petalMesh.visible = false;
          simState.petalsPlucked++;
          if (mortarPetalMeshes[simState.petalsPlucked - 1]) {
            mortarPetalMeshes[simState.petalsPlucked - 1].visible = true;
          }
          if (simState.petalsPlucked >= 4) {
            simState.hibiscusStage = 'A1';
            audio.playSuccess();
            spawnCelebration(['#f43f5e', '#fb7185', '#fbbf24']);
            showToast('🌸 All 4 petals collected! Now tap the mortar to crush them!', 'success');
          } else {
            showToast(`🌸 Petal ${simState.petalsPlucked}/4 in the mortar!`, 'success', 1400);
          }
          setAnimatingState(false);
          updateGuidanceCard();
        }
      }
      requestAnimationFrame(anim);
    }

