        tr.innerHTML = `
          <td><strong>${idx + 1}</strong></td>
          <td>
            <strong>${substance.nameEn}</strong><br>
            <span style="font-size: 0.76rem; color: #cbd5e1;">${substance.nameKn}</span>
          </td>
          <td>
            <span class="swatch" style="background: ${substance.initialColorHex};"></span>
            ${substance.initialNameEn}
          </td>
          <td>
            ${state.hibiscusTested ? `
              <span class="swatch" style="background: ${substance.hibiscusColorHex};"></span>
              <strong>${substance.hibiscusResultEn}</strong><br>
              <span style="font-size: 0.74rem; color: #cbd5e1;">${substance.hibiscusResultKn}</span>
            ` : `<span style="color: var(--text-muted); font-style: italic;">Pending (ಪರೀಕ್ಷಿಸಿ)</span>`}
          </td>
          <td>
            ${state.litmusPaperRedTested ? `
              <span class="swatch" style="background: ${substance.category === 'base' ? '#2563eb' : '#ef4444'};"></span>
              ${substance.litmusPaperRed}
            ` : `<span style="color: var(--text-muted); font-style: italic;">Pending</span>`}
          </td>
          <td>
            ${state.litmusPaperBlueTested ? `
              <span class="swatch" style="background: ${substance.category === 'acid' ? '#ef4444' : '#2563eb'};"></span>
              ${substance.litmusPaperBlue}
            ` : `<span style="color: var(--text-muted); font-style: italic;">Pending</span>`}
          </td>
          <td>
            ${state.litmusSolutionTested ? `
              <span class="swatch" style="background: ${substance.litmusSolutionHex};"></span>
              <strong>${substance.litmusSolutionResultEn}</strong>
