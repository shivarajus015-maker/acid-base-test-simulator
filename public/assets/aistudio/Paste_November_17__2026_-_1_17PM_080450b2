    /* =========================================================================
       RAYCASTER & HOVER TOOLTIP
       ========================================================================= */
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    const tooltip = document.getElementById('cursor-tooltip');

    window.addEventListener('pointermove', (e) => {
      mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

      tooltip.style.left = `${Math.min(e.clientX, window.innerWidth - 270)}px`;
      tooltip.style.top = `${Math.min(e.clientY, window.innerHeight - 80)}px`;

      if (simState.animating) {
        tooltip.style.display = 'none';
        document.body.style.cursor = 'default';
        return;
      }

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(scene.children, true);

      let hovered = null;
      for (let i = 0; i < intersects.length; i++) {
        const obj = intersects[i].object;
        if (obj.userData && (obj.userData.isPetal || obj.userData.isMortar || obj.userData.isPestle ||
            obj.userData.isBeaker || obj.userData.isFunnel || obj.userData.isHibiscusDropper ||
            obj.userData.isLichenDish || obj.userData.isRedLitmusStack || obj.userData.isBlueLitmusStack ||
            obj.userData.isLitmusDropper || obj.userData.isTubeA || obj.userData.isTubeB)) {
          hovered = obj;
          break;
        }
      }

      if (hovered) {
        document.body.style.cursor = 'pointer';
        tooltip.style.display = 'block';
        const d = hovered.userData;
        if (d.isPetal) tooltip.innerHTML = '🌺 Hibiscus Petal <br><span style="color:#94a3b8;font-size:11px">Click to pluck into mortar</span>';
        else if (d.isMortar || d.isPestle) tooltip.innerHTML = '🥣 Mortar &amp; Pestle <br><span style="color:#94a3b8;font-size:11px">Click to crush petals</span>';
        else if (d.isBeaker) tooltip.innerHTML = '♨️ Warm Water Beaker <br><span style="color:#94a3b8;font-size:11px">Click to pour into mortar</span>';
        else if (d.isFunnel || d.isHibiscusDropper) tooltip.innerHTML = '🌺 Hibiscus Filter &amp; Dropper';
        else if (d.isLichenDish) tooltip.innerHTML = '🧫 Lichen Powder <br><span style="color:#94a3b8;font-size:11px">Click to extract Litmus dye</span>';
        else if (d.isRedLitmusStack) tooltip.innerHTML = '📑 Red Litmus Paper <br><span style="color:#94a3b8;font-size:11px">Click to dip next sample</span>';
        else if (d.isBlueLitmusStack) tooltip.innerHTML = '📑 Blue Litmus Paper <br><span style="color:#94a3b8;font-size:11px">Click to dip next sample</span>';
        else if (d.isLitmusDropper) tooltip.innerHTML = '📜 Litmus Solution Dropper';
        else if (d.isTubeA) {
          const s = ALL_SUBSTANCES.find(item => item.id === d.substanceId);
          const tested = testState[s.id].hibiscusTested;
          tooltip.innerHTML = `🧪 ${d.index + 1}. ${s.nameEn} (${s.nameKn})<br><span style="color:${tested ? s.hibiscusColorHex : '#94a3b8'};font-size:11px">${tested ? '🌺 ' + s.hibiscusResultEn + ' • ' + s.typeEn : 'Click to test with Hibiscus'}</span>`;
        } else if (d.isTubeB) {
          const s = ALL_SUBSTANCES.find(item => item.id === d.substanceId);
          const st = testState[s.id];
          const tested = st.litmusSolutionTested || st.litmusPaperBlueTested || st.litmusPaperRedTested;
          tooltip.innerHTML = `🧪 ${d.index + 1}. ${s.nameEn} (${s.nameKn})<br><span style="color:${tested ? '#93c5fd' : '#94a3b8'};font-size:11px">${tested ? '✓ Tested • ' + s.typeEn : 'Click to test with Litmus'}</span>`;
        }
      } else {
        document.body.style.cursor = 'default';
        tooltip.style.display = 'none';
      }
    });

    window.addEventListener('click', (e) => {
      if (e.target.closest('.interactive') || e.target.closest('.modal-content')) return;

      audio.init();
      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(scene.children, true);

      for (let i = 0; i < intersects.length; i++) {
        const obj = intersects[i].object;
        const d = obj.userData;
        if (!d) continue;

        if (d.isPetal) { pluckPetal(obj); break; }
        if (d.isMortar || d.isPestle) { crushPetals(); break; }
        if (d.isBeaker) { addWarmWater(); break; }
        if (d.isFunnel) { filterAndBottle(); break; }
        if (d.isHibiscusDropper) {
          const idx = testTubesA.findIndex(t => !testState[t.substance.id].hibiscusTested);
          testTubeHibiscus(idx !== -1 ? idx : 0);
          break;
        }
        if (d.isTubeA) { testTubeHibiscus(d.index); break; }
        if (d.isLichenDish) { prepareLitmus(); break; }
        if (d.isRedLitmusStack) {
          const idx = testTubesB.findIndex(t => !testState[t.substance.id].litmusPaperRedTested);
          dipLitmusPaper('red', idx !== -1 ? idx : 0);
          break;
        }
        if (d.isBlueLitmusStack) {
          const idx = testTubesB.findIndex(t => !testState[t.substance.id].litmusPaperBlueTested);
          dipLitmusPaper('blue', idx !== -1 ? idx : 0);
          break;
        }
        if (d.isLitmusDropper) {
          const idx = testTubesB.findIndex(t => !testState[t.substance.id].litmusSolutionTested);
          testTubeLitmusSolution(idx !== -1 ? idx : 0);
          break;
        }
        if (d.isTubeB) {
          const s = testState[d.substanceId];
          if (!s.litmusPaperBlueTested) dipLitmusPaper('blue', d.index);
          else if (!s.litmusPaperRedTested) dipLitmusPaper('red', d.index);
          else testTubeLitmusSolution(d.index);
          break;
        }
      }
    });

    /* =========================================================================
       MATRIX TABLE
       ========================================================================= */
