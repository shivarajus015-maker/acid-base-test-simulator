            <span class="badge-cell ${badgeClass}">
              ${substance.typeEn} (${substance.typeKn})
            </span>
          </td>
        `;

        tr.addEventListener('click', () => {
          document.getElementById('results-modal').classList.remove('active');
          const tubeObj = (currentTab === 'litmus') ? testTubesB[idx] : testTubesA[idx];
          if (tubeObj) {
            const worldPos = new THREE.Vector3();
            tubeObj.container.getWorldPosition(worldPos);
            targetControlsTarget.copy(worldPos);
            targetCamPos.set(worldPos.x, worldPos.y + 1.8, worldPos.z + 3.8);
            controls.target.copy(targetControlsTarget);
          }
        });

        matrixTbody.appendChild(tr);
      });
    }

    populateMatrixTable();

    /* =========================================================================
       UI CONTROLS & SHORTCUTS
       ========================================================================= */
    function setTab(tab) {
      currentTab = tab;
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

      if (tab === 'hibiscus') {
        document.getElementById('tab-hibiscus').classList.add('active');
        targetCamPos.copy(cameraTargets.hibiscus.pos);
        targetControlsTarget.copy(cameraTargets.hibiscus.lookAt);
      } else if (tab === 'litmus') {
        document.getElementById('tab-litmus').classList.add('active');
        targetCamPos.copy(cameraTargets.litmus.pos);
        targetControlsTarget.copy(cameraTargets.litmus.lookAt);
      } else if (tab === 'compare') {
        document.getElementById('tab-compare').classList.add('active');
        targetCamPos.copy(cameraTargets.compare.pos);
        targetControlsTarget.copy(cameraTargets.compare.lookAt);
        document.getElementById('results-modal').classList.add('active');
        populateMatrixTable();
      }
      updateGuidanceCard();
    }

    document.getElementById('tab-hibiscus').addEventListener('click', () => setTab('hibiscus'));
    document.getElementById('tab-litmus').addEventListener('click', () => setTab('litmus'));
    document.getElementById('tab-compare').addEventListener('click', () => setTab('compare'));

    // Label Clean/Full toggle
    let labelsClean = true;
    const labelModeBtn = document.getElementById('label-mode-btn');
    const labelModeText = document.getElementById('label-mode-text');
    labelModeBtn.addEventListener('click', () => {
      labelsClean = !labelsClean;
      document.body.classList.toggle('labels-clean', labelsClean);
      document.body.classList.toggle('labels-full', !labelsClean);
      labelModeBtn.classList.toggle('active', labelsClean);
      labelModeText.textContent = labelsClean ? 'Labels: Clean' : 'Labels: Full';
    });

    document.getElementById('view-matrix-btn').addEventListener('click', () => {
      document.getElementById('results-modal').classList.add('active');
      populateMatrixTable();
    });

    document.getElementById('close-modal-btn').addEventListener('click', () => {
      document.getElementById('results-modal').classList.remove('active');
    });

    document.getElementById('modal-resume-btn').addEventListener('click', () => {
      document.getElementById('results-modal').classList.remove('active');
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        populateMatrixTable(btn.dataset.filter);
      });
    });

    document.getElementById('roster-toggle-btn').addEventListener('click', () => {
      isExpandedRoster = !isExpandedRoster;
      activeSubstances = isExpandedRoster ? ALL_SUBSTANCES : ALL_SUBSTANCES.slice(0, 8);
      document.getElementById('roster-btn-text').textContent = isExpandedRoster ? '13 Samples' : '8 Samples';
      buildTestTubes();
      populateMatrixTable();
      updateGuidanceCard();
    });

    const langBtn = document.getElementById('lang-btn');
    const langText = document.getElementById('lang-text');
    let langIndex = 0;
    const langModes = ['both', 'en', 'kn'];
    const langLabels = ['EN + ಕನ್ನಡ', 'English', 'ಕನ್ನಡ'];

    function toggleLanguage() {
      langIndex = (langIndex + 1) % 3;
      document.body.className = `lang-${langModes[langIndex]} ${labelsClean ? 'labels-clean' : 'labels-full'}`;
      langText.textContent = langLabels[langIndex];
    }
    langBtn.addEventListener('click', toggleLanguage);

    const soundBtn = document.getElementById('sound-btn');
    const soundIcon = document.getElementById('sound-icon');
    let soundEnabled = false;

    function toggleAudio() {
      audio.init();
      soundEnabled = !soundEnabled;
      audio.setMute(!soundEnabled);
      soundIcon.textContent = soundEnabled ? '🔊' : '🔇';
      soundBtn.classList.toggle('active', soundEnabled);
    }
    soundBtn.addEventListener('click', toggleAudio);

    document.getElementById('cam-reset-btn').addEventListener('click', () => {
      if (currentTab === 'hibiscus') {
        targetCamPos.copy(cameraTargets.hibiscus.pos);
        targetControlsTarget.copy(cameraTargets.hibiscus.lookAt);
      } else if (currentTab === 'litmus') {
        targetCamPos.copy(cameraTargets.litmus.pos);
        targetControlsTarget.copy(cameraTargets.litmus.lookAt);
      } else {
        targetCamPos.copy(cameraTargets.compare.pos);
        targetControlsTarget.copy(cameraTargets.compare.lookAt);
      }
    });

    // Sequential Auto-Step Runner
    document.getElementById('auto-step-btn').addEventListener('click', () => {
      if (simState.animating) return;
      audio.init();

      if (currentTab === 'hibiscus') {
        if (simState.hibiscusStage === 'A0') {
          const nextPetal = pluckablePetals.find(p => !p.userData.plucked);
          if (nextPetal) pluckPetal(nextPetal);
        } else if (simState.hibiscusStage === 'A1') {
          const runCrush = () => {
            if (simState.hibiscusStage === 'A1') crushPetals(runCrush);
          };
          runCrush();
        } else if (simState.hibiscusStage === 'A2') {
          addWarmWater();
        } else if (simState.hibiscusStage === 'A3') {
          filterAndBottle();
        } else if (simState.hibiscusStage === 'A4') {
          const idx = testTubesA.findIndex(t => !testState[t.substance.id].hibiscusTested);
          testTubeHibiscus(idx !== -1 ? idx : 0);
        }
      } else if (currentTab === 'litmus') {
        if (!simState.litmusPrepared) {
          prepareLitmus();
        } else {
          const idx = testTubesB.findIndex(t => !testState[t.substance.id].litmusSolutionTested);
          const chosen = idx !== -1 ? idx : 0;
          const st = testState[testTubesB[chosen].substance.id];
          if (!st.litmusPaperBlueTested) dipLitmusPaper('blue', chosen);
          else if (!st.litmusPaperRedTested) dipLitmusPaper('red', chosen);
          else testTubeLitmusSolution(chosen);
        }
      }
    });

    function resetAll() {
      audio.init();
      resetTestState();
      simState.petalsPlucked = 0;
      simState.crushCount = 0;
      simState.waterAdded = false;
      simState.isFiltered = false;
      simState.litmusPrepared = false;
      simState.hibiscusStage = 'A0';
      simState.litmusStage = 'B1';
      setAnimatingState(false);

      resetFlowerPetals();

      mortarPetalMeshes.forEach(p => {
        p.visible = false;
        p.material.color.set('#e11d48');
      });

      mortarLiquidMat.uniforms.uOpacity.value = 0.0;
      bottleLiquidMat.uniforms.uOpacity.value = 0.0;
      litmusBottleLiquidMat.uniforms.uOpacity.value = 0.0;
      beakerWater.scale.y = 1.0;

      while (pinnedItemsGroup.children.length > 0) {
        pinnedItemsGroup.remove(pinnedItemsGroup.children[0]);
      }
      pinnedStrips.length = 0;

      buildTestTubes();
      populateMatrixTable();
      document.getElementById('results-modal').classList.remove('active');
      setTab('hibiscus');
      audio.playSuccess();
      showToast('↺ Fresh lab bench ready! Let’s begin!', 'success', 2000);
    }

    document.getElementById('reset-btn').addEventListener('click', resetAll);
    document.getElementById('modal-reset-btn').addEventListener('click', resetAll);

    window.addEventListener('keydown', (e) => {
      if (e.key === '1') setTab('hibiscus');
      if (e.key === '2') setTab('litmus');
      if (e.key === '3') setTab('compare');
      if (e.key === 'r' || e.key === 'R') resetAll();
      if (e.key === 'm' || e.key === 'M') toggleAudio();
      if (e.key === 'l' || e.key === 'L') toggleLanguage();
      if (e.key === 'Escape') document.getElementById('results-modal').classList.remove('active');
    });

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      labelRenderer.setSize(window.innerWidth, window.innerHeight);
      resizeConfetti();
    });

    /* =========================================================================
       MAIN ANIMATION LOOP
       ========================================================================= */
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const time = clock.getElapsedTime();

      camera.position.lerp(targetCamPos, 0.05);
      controls.target.lerp(targetControlsTarget, 0.05);
      controls.update();

      // Gentle pulse on guideRing
      if (guideRing.visible) {
        const s = 1.0 + Math.sin(time * 4.5) * 0.1;
        guideRing.scale.set(s, s, 1);
        guideRing.material.opacity = 0.55 + Math.sin(time * 4.5) * 0.3;
      }

      // Steam animation
      const steamPos = steamGeo.attributes.position.array;
      for (let s = 0; s < steamParticleCount; s++) {
        steamPos[s * 3 + 1] += 0.012;
        if (steamPos[s * 3 + 1] > 2.8) {
          steamPos[s * 3 + 1] = 1.3;
          steamPos[s * 3] = (Math.random() - 0.5) * 0.8;
          steamPos[s * 3 + 2] = (Math.random() - 0.5) * 0.8;
        }
      }
      steamGeo.attributes.position.needsUpdate = true;

      testTubesA.forEach(t => { t.liquidMat.uniforms.uTime.value = time; });
      testTubesB.forEach(t => { t.liquidMat.uniforms.uTime.value = time; });
      mortarLiquidMat.uniforms.uTime.value = time;

      updateConfetti();

      renderer.render(scene, camera);
      labelRenderer.render(scene, camera);
    }

    animate();
    updateGuidanceCard();
  </script>
