    function dipLitmusPaper(paperType, tubeIndex, onDone) {
      if (simState.animating) return;
      const targetTube = testTubesB[tubeIndex];
      if (!targetTube) return;

      const substance = targetTube.substance;
      const isRed = paperType === 'red';
      setAnimatingState(true, `📑 Dipping ${isRed ? 'Red' : 'Blue'} Litmus in ${substance.nameEn}...`);
      audio.init();
      audio.playPaperDip();

      let targetColorHex = isRed ? '#ef4444' : '#2563eb';
      if (isRed && substance.category === 'base') targetColorHex = '#2563eb';
      else if (!isRed && substance.category === 'acid') targetColorHex = '#ef4444';

      activePaperStrip.material.dispose();
      activePaperStrip.material = createPaperShaderMaterial(isRed ? '#ef4444' : '#2563eb', targetColorHex);
      activePaperStrip.visible = true;

      const tubeWorld = new THREE.Vector3();
      targetTube.container.getWorldPosition(tubeWorld);
      activePaperStrip.position.set(tubeWorld.x, 2.2, tubeWorld.z);
      activePaperStrip.rotation.set(0, 0, 0);

      const startTime = performance.now();
      const duration = 2100;

      function anim(t) {
        const p = Math.min((t - startTime) / duration, 1.0);

        if (p < 0.25) {
          activePaperStrip.position.y = 2.2 - (p / 0.25) * 1.1;
        } else if (p < 0.65) {
          activePaperStrip.material.uniforms.uProgress.value = (p - 0.25) / 0.4;
        } else if (p < 0.8) {
          activePaperStrip.position.y = 1.1 + ((p - 0.65) / 0.15) * 1.1;
        } else {
          const pFly = (p - 0.8) / 0.2;
          const boardTargetPos = new THREE.Vector3(7.5, 1.4, -1.55);
          activePaperStrip.position.lerp(boardTargetPos, pFly);
        }

        if (p < 1.0) {
          requestAnimationFrame(anim);
        } else {
          activePaperStrip.visible = false;
          audio.playPin();

          const pinnedMesh = new THREE.Mesh(activeStripGeo.clone(), activePaperStrip.material.clone());
          pinnedMesh.scale.set(0.62, 0.62, 0.62);
          const pinX = (pinnedStrips.length % 5) * 0.44 - 0.88;
          const pinY = 1.65 - Math.floor(pinnedStrips.length / 5) * 0.72;
          pinnedMesh.position.set(pinX, pinY, 0.06);
          pinnedItemsGroup.add(pinnedMesh);
          pinnedStrips.push(pinnedMesh);

          const pushpin = new THREE.Mesh(
            new THREE.SphereGeometry(0.04, 12, 12),
            new THREE.MeshStandardMaterial({ color: '#f59e0b', metalness: 0.8 })
          );
          pushpin.position.set(pinX, pinY + 0.32, 0.1);
          pinnedItemsGroup.add(pushpin);

          if (isRed) testState[substance.id].litmusPaperRedTested = true;
          else testState[substance.id].litmusPaperBlueTested = true;

          const badgeClass = substance.category === 'acid' ? 'tested-acid' : (substance.category === 'base' ? 'tested-base' : 'tested-neutral');
          targetTube.labelDiv.className = `label-3d tube-pill ${badgeClass}`;
          targetTube.labelDiv.innerHTML = renderTubeLabelHTML(
            tubeIndex,
            substance,
            `📜 ${isRed ? 'Red' : 'Blue'}: ${isRed ? substance.litmusPaperRed : substance.litmusPaperBlue}`,
            targetColorHex
          );

          audio.playSuccess();
          const msg = isRed ? substance.litmusPaperRed : substance.litmusPaperBlue;
          showToast(`📑 ${isRed ? 'Red' : 'Blue'} Paper in ${substance.nameEn}: ${msg}`, substance.category, 2600);

          setAnimatingState(false);
          updateGuidanceCard();
          populateMatrixTable();
          if (onDone) onDone();
        }
      }
      requestAnimationFrame(anim);
    }

