    /* =========================================================================
       HAPPY TOAST & CONFETTI CELEBRATION ENGINE
       ========================================================================= */
    const toastWrap = document.getElementById('activity-toast-wrap');
    let activeToastTimer = null;

    function showToast(text, type = 'success', duration = 2600) {
      toastWrap.innerHTML = '';
      const el = document.createElement('div');
      el.className = `activity-toast ${type}`;
      el.textContent = text;
      toastWrap.appendChild(el);
      if (activeToastTimer) clearTimeout(activeToastTimer);
      activeToastTimer = setTimeout(() => {
        el.classList.add('fade-out');
        setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, 300);
      }, duration);
    }

    const confettiCanvas = document.getElementById('confetti-canvas');
    const confettiCtx = confettiCanvas.getContext('2d');
    const confettiParticles = [];

    function resizeConfetti() {
      confettiCanvas.width = window.innerWidth;
      confettiCanvas.height = window.innerHeight;
    }
    resizeConfetti();

    function spawnCelebration(colors = ['#f43f5e', '#fbbf24', '#10b981', '#38bdf8', '#a855f7']) {
      for (let i = 0; i < 38; i++) {
        confettiParticles.push({
          x: window.innerWidth * (0.35 + Math.random() * 0.3),
          y: window.innerHeight * 0.55,
          vx: (Math.random() - 0.5) * 9,
          vy: -4 - Math.random() * 7,
          size: 4 + Math.random() * 5,
          color: colors[Math.floor(Math.random() * colors.length)],
          life: 1.0,
          rot: Math.random() * Math.PI * 2,
          vRot: (Math.random() - 0.5) * 0.25
        });
      }
    }

    function updateConfetti() {
      if (confettiParticles.length === 0) {
        confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        return;
      }
      confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
      for (let i = confettiParticles.length - 1; i >= 0; i--) {
        const p = confettiParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.22;
        p.rot += p.vRot;
        p.life -= 0.018;
        if (p.life <= 0) {
          confettiParticles.splice(i, 1);
          continue;
        }
        confettiCtx.save();
        confettiCtx.globalAlpha = Math.max(0, p.life);
        confettiCtx.translate(p.x, p.y);
        confettiCtx.rotate(p.rot);
        confettiCtx.fillStyle = p.color;
        confettiCtx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.65);
        confettiCtx.restore();
      }
    }

    /* =========================================================================
       STANDALONE ORBITCONTROLS
       ========================================================================= */
    class StandaloneOrbitControls {
      constructor(camera, domElement) {
        this.camera = camera;
        this.domElement = domElement || document.body;
        this.target = new THREE.Vector3(0, 0, 0);
        this.minDistance = 2.0;
        this.maxDistance = 25.0;
        this.minPolarAngle = 0.05;
        this.maxPolarAngle = Math.PI / 2 - 0.04;
        this.enableDamping = true;
        this.dampingFactor = 0.08;

        this.spherical = new THREE.Spherical();
        this.sphericalDelta = new THREE.Spherical();
        this.panOffset = new THREE.Vector3();

        const offset = new THREE.Vector3().subVectors(this.camera.position, this.target);
        this.spherical.setFromVector3(offset);

        this.isPointerDown = false;
        this.pointerType = 'none';
        this.prevPointerPos = { x: 0, y: 0 };

        this._onPointerDown = this.onPointerDown.bind(this);
        this._onPointerMove = this.onPointerMove.bind(this);
        this._onPointerUp = this.onPointerUp.bind(this);
        this._onWheel = this.onWheel.bind(this);

        this.domElement.addEventListener('pointerdown', this._onPointerDown);
        window.addEventListener('pointermove', this._onPointerMove);
        window.addEventListener('pointerup', this._onPointerUp);
        this.domElement.addEventListener('wheel', this._onWheel, { passive: false });
        this.domElement.addEventListener('contextmenu', (e) => e.preventDefault());
      }

      onPointerDown(e) {
        this.isPointerDown = true;
        this.pointerType = (e.button === 2 || e.shiftKey) ? 'pan' : 'rotate';
        this.prevPointerPos = { x: e.clientX, y: e.clientY };
      }

      onPointerMove(e) {
        if (!this.isPointerDown) return;
        const dx = e.clientX - this.prevPointerPos.x;
        const dy = e.clientY - this.prevPointerPos.y;
        this.prevPointerPos = { x: e.clientX, y: e.clientY };

        if (this.pointerType === 'rotate') {
          const rotSpeed = 0.005;
          this.sphericalDelta.theta -= dx * rotSpeed;
          this.sphericalDelta.phi -= dy * rotSpeed;
        } else if (this.pointerType === 'pan') {
          const panSpeed = 0.004 * this.spherical.radius;
          const vX = new THREE.Vector3().setFromMatrixColumn(this.camera.matrix, 0);
          const vY = new THREE.Vector3().setFromMatrixColumn(this.camera.matrix, 1);
          vX.multiplyScalar(-dx * panSpeed);
          vY.multiplyScalar(dy * panSpeed);
          this.panOffset.add(vX).add(vY);
        }
      }

      onPointerUp() {
        this.isPointerDown = false;
        this.pointerType = 'none';
      }

      onWheel(e) {
        e.preventDefault();
        const zoomFactor = e.deltaY < 0 ? 0.93 : 1.07;
        this.spherical.radius = THREE.MathUtils.clamp(
          this.spherical.radius * zoomFactor,
          this.minDistance,
          this.maxDistance
        );
      }

      update() {
        this.target.add(this.panOffset);
        this.panOffset.set(0, 0, 0);

        if (this.enableDamping) {
          this.spherical.theta += this.sphericalDelta.theta * (1 - this.dampingFactor);
          this.spherical.phi += this.sphericalDelta.phi * (1 - this.dampingFactor);
          this.sphericalDelta.theta *= this.dampingFactor;
          this.sphericalDelta.phi *= this.dampingFactor;
        } else {
          this.spherical.theta += this.sphericalDelta.theta;
          this.spherical.phi += this.sphericalDelta.phi;
          this.sphericalDelta.set(0, 0, 0);
        }

        this.spherical.phi = THREE.MathUtils.clamp(this.spherical.phi, this.minPolarAngle, this.maxPolarAngle);
        this.spherical.radius = THREE.MathUtils.clamp(this.spherical.radius, this.minDistance, this.maxDistance);

        const offset = new THREE.Vector3().setFromSpherical(this.spherical);
        this.camera.position.copy(this.target).add(offset);
        this.camera.lookAt(this.target);
      }
    }

    /* =========================================================================
       CSS2D RENDERER
       ========================================================================= */
    class CSS2DObject extends THREE.Object3D {
      constructor(element = document.createElement('div')) {
